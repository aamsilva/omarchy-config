{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 999999
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "quickshell.spotify"
        },
        {
          "id": "io.github.diegopluna.argus",
          "show": [
            "cpu",
            "cputemp",
            "ram",
            "gpu",
            "gputemp",
            "vram",
            "disk",
            "io",
            "net",
            "load"
          ]
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "io.github.qadram.nvme-health"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "dev.bvisagie.quadrant"
        },
        {
          "id": "io.github.x3me.nexthop"
        },
        {
          "id": "akitaonrails.ai-usagebar"
        },
        {
          "id": "io.github.thisisgm.omapods"
        },
        {
          "id": "io.github.woogy7.vitals"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": []
}
